<Project Sdk="Microsoft.NET.Sdk">

  <!-- Roda os mesmos testes de EditMode do Unity com o NUnit oficial. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Mmorpg.Core.Tests</AssemblyName>
    <RootNamespace>Mmorpg.Core.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../client/Assets/Tests/EditMode/**/*.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <ProjectReference Include="../core/Mmorpg.Core.csproj" />
  </ItemGroup>

</Project>
